# Copy to .env and fill in. Never commit .env.

# --- Webex integration (developer.webex.com → My Webex Apps → your integration) ---
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REDIRECT_URI=http://localhost:8000/oauth/callback

# --- Priority bot (developer.webex.com → My Webex Apps → your bot) ---
PRIORITY_BOT_TOKEN=

# --- Listener ---
# webhook = Webex calls us through ngrok (instant). polling = we ask Webex every POLL_INTERVAL seconds (no ngrok).
LISTENER_MODE=webhook
# Webhook mode only: the https URL printed by `ngrok http 8000`
PUBLIC_URL=
# Webhook mode only: any random string; Webex signs each webhook with it so we can verify it's real
WEBHOOK_SECRET=
# Polling mode only: seconds between checks
POLL_INTERVAL=10

# --- Storage ---
DB_PATH=data/focus.db

# --- Company network only (leave commented out at home) ---
# HTTPS_PROXY=http://proxy.example.com:8080
# SSL_CERT_FILE=/path/to/company-ca-bundle.pem
