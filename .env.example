# Copy to .env and fill in. Never commit .env.

# --- Webex integration (developer.webex.com → My Webex Apps → your integration) ---
# The scopes the login asks for must ALL be ticked on the integration page, or Webex says "invalid_scope".
# Empty = messages_read, messages_write, rooms_read, people_read, kms. Or tick spark:all on the integration
# and use the line below.
WEBEX_SCOPES=spark:all spark:kms
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REDIRECT_URI=http://localhost:8000/oauth/callback

# --- Listener ---
# polling = we ask Webex every POLL_INTERVAL seconds (no ngrok; works on the company network).
# webhook = Webex calls us through ngrok (instant; home setup only).
LISTENER_MODE=polling
# Polling mode only: seconds between checks (decimals OK, e.g. 0.5; watch for HTTP 429 rate limits)
POLL_INTERVAL=2
# Webhook mode only: the https URL printed by `ngrok http 8000` (empty = auto-detect from ngrok)
PUBLIC_URL=
# Webhook mode only: any random string; Webex signs each webhook with it so we can verify it's real
WEBHOOK_SECRET=

# --- Alerts for High priority messages (only while focus mode is on) ---
# assistant_space = post in your private "Webex Assistant" Webex space (the record; sent as you, so no buzz)
# desktop         = desktop notification (the real alert)
NOTIFY_CHANNELS=assistant_space,desktop
# Your chat with the assistant: create a space in Webex yourself (only you in it) with exactly this title.
# Posts from the assistant are sent as you, so they start with a header (templates/chat/space_post.md)
# showing ASSISTANT_NAME, to tell them apart from your own messages.
ASSISTANT_SPACE_TITLE=Webex Assistant
ASSISTANT_NAME=Webex Assistant
# osascript (macOS built-in; allow "Script Editor" in System Settings → Notifications) | windows | auto | off
# terminal-notifier also works on older macOS (clickable), but recent macOS blocks it.
DESKTOP_NOTIFIER=osascript
UI_URL=http://localhost:8000

# --- AI (OpenAI API; later the company gateway: set OPENAI_BASE_URL and its key) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Any chat model your key can use (list them: python -m shared.llm --models)
LLM_MODEL=gpt-4.1-mini
# AI triage decides High vs Regular when no rule matched (on/off). TRIAGE_MODEL defaults to LLM_MODEL.
AI_TRIAGE=on
TRIAGE_MODEL=

# --- Summaries & email (email is mocked: written to data/outbox/ as .eml + .html) ---
EOD_ENABLED=on
EOD_TIME=23:59
# all = everything that day; held = only Regular messages
EOD_SCOPE=all
# empty = your Webex email
EMAIL_TO=

# --- Storage ---
DB_PATH=data/focus.db

# --- Company network only (leave commented out at home) ---
# HTTPS_PROXY=http://proxy.example.com:8080
# SSL_CERT_FILE=/path/to/company-ca-bundle.pem
